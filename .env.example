# ==========================================
# Nextcloud & Reverse Proxy Environment File
# ==========================================
# Rename this file to `.env` and fill in your details

# -----------------
# 1. Domain Details
# -----------------
# Your main Nextcloud domain (e.g. cloud.example.com)
NEXTCLOUD_DOMAIN=your.domain.com

# -----------------
# 2. Database Config
# -----------------
DB_ROOT_PASSWORD=your_secure_root_password
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=your_secure_db_password

# -----------------
# 3. Nextcloud Admin
# -----------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=your_secure_admin_password
